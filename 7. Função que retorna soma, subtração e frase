<?php
function calcular($a, $b)
{
    $soma = $a + $b;
    $sub = $a - $b;

    return [
        "soma" => $soma,
        "subtracao" => $sub,
        "frase" => "Você é incrível!"
    ];
}
$resultado = calcular(10, 5);

echo "Soma: " . $resultado["soma"] . "<br>";
echo "Subtração: " . $resultado["subtracao"] . "<br>";
echo $resultado["frase"];
?>
